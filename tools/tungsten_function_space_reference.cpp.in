template<class T> T lerp(T a,T b,T t) { return a*(T(1)-t)+b*t; }
enum class Derivative { None,First };
enum class GPCorrelationContext { None,Renewal,RenewalPlus,Global };
struct PathSampleGenerator {
    std::uint64_t state;
    std::vector<double> tape;
    explicit PathSampleGenerator(std::uint64_t seed):state(seed) { next1D(); next1D(); tape.clear(); }
    float next1D() {
        std::uint64_t old=state; state=old*6364136223846793005ULL+1;
        std::uint32_t x=std::uint32_t(((old>>18u)^old)>>27u), r=std::uint32_t(old>>59u);
        const auto bits=(x>>r)|(x<<((32u-r)&31));
        float value=float(bits>>9u)/8388608.f; tape.push_back(value); return value;
    }
};
template<class Mat,class Vec> struct TangentFrameD {
    Vec normal,tangent,bitangent;
    explicit TangentFrameD(const Vec& n):normal(n) {
        const double sign=n.z()<0?-1.:1., a=-1./(sign+n.z()), b=n.x()*n.y()*a;
        tangent=Vec(1.+sign*n.x()*n.x()*a,sign*b,-sign*n.x());
        bitangent=Vec(b,sign+n.y()*n.y()*a,-n.y());
    }
    Vec toGlobal(const Vec& p) const { return tangent*p.x()+bitangent*p.y()+normal*p.z(); }
};
struct Constraint { int startIdx,endIdx; float minV,maxV; };
